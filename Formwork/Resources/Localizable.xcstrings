    "downgrade.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Premium-Abo ist abgelaufen. Du kannst bis zu %#@workoutLimit@ und %#@exerciseLimit@ behalten. Alles andere wird archiviert und kann in den Einstellungen wiederhergestellt werden."
          },
          "substitutions" : {
            "exerciseLimit" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg aktive Übung"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg aktive Übungen"
                    }
                  }
                }
              }
            },
            "workoutLimit" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg aktives Workout"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg aktive Workouts"
                    }
                  }
                }
              }
            }
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Premium subscription has ended and you can keep up to %#@workoutLimit@ and %#@exerciseLimit@. Everything else is archived and can be restored in settings."
          },
          "substitutions" : {
            "exerciseLimit" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg active exercise"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg active exercises"
                    }
                  }
                }
              }
            },
            "workoutLimit" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg active workout"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg active workouts"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
