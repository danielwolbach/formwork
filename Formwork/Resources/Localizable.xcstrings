    "alert.deleteExercise.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Übung wird gelöscht und aus der Statistik entfernt. Um sie in deiner Statistik zu behalten, archiviere sie. Der Löschvorgang kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This exercise will be deleted and removed from your statistics. To keep it in your statistics, archive it instead. This action cannot be undone."
          }
        }
      }
    },
