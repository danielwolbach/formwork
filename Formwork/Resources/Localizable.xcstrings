      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your access to the full version has ende and you can keep up to %#@workoutLimit@ and %#@exerciseLimit@. Everything else is archived and can be restored in settings."
