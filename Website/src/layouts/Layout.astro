---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getTranslations } from "@/i18n";

interface Props {
    /** Page name, shown as "Title – Formwork". Without it the title is just "Formwork". */
    title?: string;
    description?: string;
}

const t = getTranslations(Astro.currentLocale);
const { title, description = t.description } = Astro.props;
---

<html lang={Astro.currentLocale}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />

        <link rel="icon" type="image/svg+xml" href="/favicon-light.svg" media="(prefers-color-scheme: light)" />
        <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)" />

        <title>{title ? `${title} - Formwork` : "Formwork"}</title>
    </head>

    <body class="flex min-h-screen flex-col bg-primary text-primary">
        <Header {...t.header} />

        <main class="w-full flex-1 py-16">
            <div class="mx-auto flex w-full max-w-5xl flex-col gap-24 px-4">
                <slot />
            </div>
        </main>

        <Footer {...t.footer} />
    </body>
</html>
