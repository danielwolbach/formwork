    "Stats" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statistiken"
          }
        }
      }
    },
    "This will delete the exercise and remove it from all workouts and active sessions. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird die Übung gelöscht und aus allen Workouts und aktiven Sessions entfernt. Dieser Vorgang kann nicht rückgängig gemacht werden."
          }
        }
      }
    },
    "This will delete the workout and all of its entries. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden das Workout und alle dazugehörigen Einträge gelöscht. Dieser Vorgang kann nicht rückgängig gemacht werden."
          }
        }
      }
    },
    "This will discard the active session." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird die aktive Session verworfen."
          }
        }
      }
    },
    "This will end the active session." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird die aktive Session beendet."
          }
        }
      }
    },
    "This will remove the exercise from the workout. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird die Übung aus dem Workout entfernt. Dieser Vorgang kann nicht rückgängig gemacht werden."
          }
        }
      }
    },
